{
  "manifest_version": 3,
  "name": "Calvin's Dashboard",
  "version": "0.1",
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
"permissions": ["declarativeNetRequest"],
"host_permissions": ["https://nekos.best/*,"https://api.open-meteo.com/*"],
"declarative_net_request": {
	"rule_resources": [
{ "id": "nekos_rules", "enabled": true, "path": "rules.json" }
]
}
}

